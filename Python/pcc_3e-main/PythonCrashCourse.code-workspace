{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"python.envFile": "${workspaceFolder}/.env", // Load environment variables from .env file,
		"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python", // Path to your virtual environment
			"python.terminal.activateEnvironment": true,
		"terminal.integrated.env.osx": {
			"VIRTUAL_ENV": "${workspaceFolder}/.venv",
			"PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
		}
	}
}